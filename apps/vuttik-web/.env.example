# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y NUNCA debe commitearse.

# --- Obligatorios en producción ---------------------------------------------
# El servidor se niega a arrancar en producción si faltan o miden menos de 32
# caracteres. Genera cada uno con:  openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

NODE_ENV=production
PORT=3005

# --- Google OAuth ------------------------------------------------------------
# Obtenidos en https://console.cloud.google.com/apis/credentials
# El secreto ANTERIOR estaba escrito en el código fuente: hay que revocarlo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Login ----------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Gemini (escaneo de imágenes con IA) -------------------------------------
# Solo del lado servidor. No lo expongas con prefijo VITE_: todo lo que empieza
# por VITE_ acaba en el JavaScript que descarga cada visitante.
GEMINI_API_KEY=

# --- Correo saliente ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Publicidad: relleno con AdSense ----------------------------------------
# Si se dejan vacíos, los huecos sin campaña propia simplemente no se muestran.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_PRODUCT_DETAIL=
ADSENSE_SLOT_SEARCH=
ADSENSE_SLOT_INTERSTITIAL=

# --- Variables del frontend (se incrustan en el bundle público) --------------
# Solo valores que puedan ser públicos.
VITE_APP_URL=https://vuttik.com
VITE_API_URL=https://vuttik.com
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
